{
  "name": "reel-studio-kit",
  "version": "1.0.0",
  "description": "A Claude Code folder that makes vertical reels: script, voice, synced captions, scenes, avatar, render and self-check.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "new": "node tools/new-reel.mjs",
    "voice": "NODE_USE_ENV_PROXY=1 node tools/voice/index.mjs",
    "voice:timed": "NODE_USE_ENV_PROXY=1 node tools/voice/elevenlabs-timed.mjs",
    "voice:dry": "node tools/voice/dry.mjs",
    "sync": "node tools/sync.mjs",
    "lipsync": "node tools/lipsync.mjs",
    "check": "node tools/check.mjs",
    "render": "node tools/render.mjs",
    "setup:captions": "bash tools/setup-captions.sh",
    "demo:assets": "node tools/demo/make-demo.mjs",
    "demo": "node tools/render.mjs Demo",
    "sprites:placeholders": "node tools/make-placeholder-sprites.mjs",
    "broll": "NODE_USE_ENV_PROXY=1 node tools/broll.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
